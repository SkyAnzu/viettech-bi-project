      "NONE": "Non-personal operational or catalog attribute.",
      "INTERNAL": "Internal business or financial attribute with no direct personal identification.",
      "PSEUDONYMIZED": "Deterministic pseudonymized identifier or coarse analytical attribute allowed in mart.",
      "PII_RESTRICTED": "Direct PII or sensitive quasi-identifier restricted to Zone A (raw/stg/pii_vault) and prohibited from Zone B (retailbi_mart) under PDPL 91/2025/QH15."
    },
    "mart_prohibited_pii_columns": [
      "first_name",
      "last_name",
      "full_name",
      "email",
      "phone",
      "date_of_birth"
